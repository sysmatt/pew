#!/bin/bash
# Runs the real ../pew against this lab's inventory automatically, so you
# don't have to repeat --inventory test/inventory.ini on every call.
# Usage: test/bin/pew run --hosts testlab --yes -- uptime
#        test/bin/pew list --hosts testlab --where ansible_distribution=Ubuntu
set -euo pipefail
cd "$(dirname "$0")/.."   # -> test/

if [ ! -f inventory.ini ]; then
    echo "test/inventory.ini not found — run test/bin/up.sh first." >&2
    exit 1
fi

if [ $# -eq 0 ]; then
    exec ../pew --help
fi

subcommand="$1"; shift
exec ../pew "$subcommand" --inventory "$(pwd)/inventory.ini" "$@"
